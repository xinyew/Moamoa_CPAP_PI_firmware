/*
 * KMM PMask Control board — Raytac MDBT50Q-P1MV2 module (nRF52840)
 *
 * Redesign of the CPAP PI control board:
 * - Normal-voltage mode (VDD = VDDH = 3.3 V) — no REGOUT0 dependence
 * - Mask link: I2C only, via PCA9517A repeater (EN = P0.14) over a
 *   SYMMETRIC 30-pin FFC (orientation-proof); mask mux reset = P0.16
 * - The mask carries a TCA9546A @0x70 with 4 site clusters:
 *     ch0/ch2/ch3: MAX30101 (0x57) + MS5611 in I2C mode (0x77)
 *                  + SHT40 (0x44) + TMP117 (0x48)
 *     ch1:         MAX30101 + MS5611 only
 * - microSD on SPI (CS P0.12), battery divider (1M/1M) on AIN7,
 *   mask-presence pins (grounded on the mask) P0.30/P0.28,
 *   4 active-low debug LEDs, reset button on P0.18
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <nordic/nrf52840_partition.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>
#include "kmm_pmask_control_nrf52840-pinctrl.dtsi"

/ {
	model = "KMM PMask Control nRF52840";
	compatible = "kamoamoa,kmm-pmask-control-nrf52840";

	chosen {
		zephyr,boot-mode = &boot_mode0;
	};

	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpio0 19 GPIO_ACTIVE_LOW>;
			label = "DEBUG_LED0";
		};

		led1: led_1 {
			gpios = <&gpio0 21 GPIO_ACTIVE_LOW>;
			label = "DEBUG_LED1";
		};

		led2: led_2 {
			gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
			label = "DEBUG_LED2";
		};

		led3: led_3 {
			gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;
			label = "DEBUG_LED3";
		};
	};

	zephyr,user {
		/* PCA9517A repeater enable — must be HIGH before any mask
		 * I2C traffic
		 */
		pca-en-gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
		/* Mask presence: these FFC pins are grounded on the mask,
		 * so active-low + pull-up = "logical 1 when mask attached".
		 * Two pins because the symmetric cable maps A<->B when
		 * flipped; both are grounded mask-side.
		 */
		presen-a-gpios = <&gpio0 30 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		presen-b-gpios = <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		/* Battery voltage via 1M/1M divider */
		io-channels = <&adc 7>;
	};

	aliases {
		led0 = &led0;
		led1 = &led1;
		led2 = &led2;
		led3 = &led3;
		watchdog0 = &wdt0;
	};
};

&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* BATT_SENSE = VBAT/2 (1M/1M). Gain 1/6, 0.6 V ref -> 3.6 V full
	 * scale; max acquisition time for the 500 kohm source impedance.
	 */
	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 40)>;
		zephyr,input-positive = <NRF_SAADC_AIN7>; /* P0.31 */
		zephyr,resolution = <12>;
	};
};

&uicr {
	gpio-as-nreset;
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
	gpio-line-names = "", "", "", "", "", "", "", "SD_MISO",
			  "", "", "", "SD_SCK", "SD_CS", "I2C_SDA", "PCA_EN",
			  "I2C_SCL", "MUX_RST", "", "RESET", "LED0", "LED2",
			  "LED1", "LED3", "", "", "", "", "",
			  "PRESEN_B", "", "PRESEN_A", "BATT_SENSE";
};

&gpio1 {
	status = "okay";
	gpio-line-names = "", "", "", "", "", "", "", "",
			  "", "SD_MOSI", "", "", "", "", "", "";
};

/* Mask bus: PCA9517A repeater (transparent) then the mask's TCA9546A
 * mux @0x70 (A0=A1=GND), reset via P0.16. Bus pull-ups are on the
 * mask (4.7k to 3.3 V per channel).
 */
&i2c0 {
	status = "okay";
	/* Fast mode is essential: ~26 mux-switched transactions per 10 ms
	 * tick (4x PPG + baro cycle) do not fit at the 100 kHz default.
	 * All devices (PCA9517A, TCA9546A, MAX30101, MS5611, SHT40,
	 * TMP117) are 400 kHz capable.
	 */
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";

	tca9546a: tca9546a@70 {
		compatible = "ti,tca9546a";
		reg = <0x70>;
		status = "okay";
		#address-cells = <1>;
		#size-cells = <0>;
		reset-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;

		mux_i2c0: mux_i2c@0 {
			compatible = "ti,tca9546a-channel";
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			ppg1: max30101@57 {
				compatible = "maxim,max30101";
				reg = <0x57>;
				acq-mode = "multi-led";
				led-slot = <1 2 3 0>; /* R, IR, G */
				smp-sr = <100>;
				led-pw = <411>;
				fifo-rollover-en;
				led-pa = [1f 1f 7f];
				adc-rge = <16384>;
			};

			baro1: ms5611@77 {
				compatible = "meas,ms5611-i2c";
				reg = <0x77>;
			};

			sht1: sht4x@44 {
				compatible = "sensirion,sht4x";
				reg = <0x44>;
				repeatability = <2>;
			};

			tmp1: tmp117@48 {
				compatible = "ti,tmp11x";
				reg = <0x48>;
			};
		};

		mux_i2c1: mux_i2c@1 {
			compatible = "ti,tca9546a-channel";
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			ppg2: max30101@57 {
				compatible = "maxim,max30101";
				reg = <0x57>;
				acq-mode = "multi-led";
				led-slot = <1 2 3 0>;
				smp-sr = <100>;
				led-pw = <411>;
				fifo-rollover-en;
				led-pa = [1f 1f 7f];
				adc-rge = <16384>;
			};

			baro2: ms5611@77 {
				compatible = "meas,ms5611-i2c";
				reg = <0x77>;
			};
		};

		mux_i2c2: mux_i2c@2 {
			compatible = "ti,tca9546a-channel";
			reg = <2>;
			#address-cells = <1>;
			#size-cells = <0>;

			ppg3: max30101@57 {
				compatible = "maxim,max30101";
				reg = <0x57>;
				acq-mode = "multi-led";
				led-slot = <1 2 3 0>;
				smp-sr = <100>;
				led-pw = <411>;
				fifo-rollover-en;
				led-pa = [1f 1f 7f];
				adc-rge = <16384>;
			};

			baro3: ms5611@77 {
				compatible = "meas,ms5611-i2c";
				reg = <0x77>;
			};

			sht2: sht4x@44 {
				compatible = "sensirion,sht4x";
				reg = <0x44>;
				repeatability = <2>;
			};

			tmp2: tmp117@48 {
				compatible = "ti,tmp11x";
				reg = <0x48>;
			};
		};

		mux_i2c3: mux_i2c@3 {
			compatible = "ti,tca9546a-channel";
			reg = <3>;
			#address-cells = <1>;
			#size-cells = <0>;

			ppg4: max30101@57 {
				compatible = "maxim,max30101";
				reg = <0x57>;
				acq-mode = "multi-led";
				led-slot = <1 2 3 0>;
				smp-sr = <100>;
				led-pw = <411>;
				fifo-rollover-en;
				led-pa = [1f 1f 7f];
				adc-rge = <16384>;
			};

			baro4: ms5611@77 {
				compatible = "meas,ms5611-i2c";
				reg = <0x77>;
			};

			sht3: sht4x@44 {
				compatible = "sensirion,sht4x";
				reg = <0x44>;
				repeatability = <2>;
			};

			tmp3: tmp117@48 {
				compatible = "ti,tmp11x";
				reg = <0x48>;
			};
		};
	};
};

/* microSD card, SPI mode */
&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 12 GPIO_ACTIVE_LOW>;

	sdhc0: sdhc@0 {
		compatible = "zephyr,sdhc-spi-slot";
		reg = <0>;
		status = "okay";
		spi-max-frequency = <8000000>;

		mmc {
			compatible = "zephyr,sdmmc-disk";
			disk-name = "SD";
			status = "okay";
		};
	};
};

&gpregret1 {
	status = "okay";

	boot_mode0: boot_mode@0 {
		compatible = "zephyr,retention";
		status = "okay";
		reg = <0x0 0x1>;
	};
};
