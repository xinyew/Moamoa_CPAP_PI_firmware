# Enable GPIO and MPU
CONFIG_GPIO=y
CONFIG_ARM_MPU=y

# Subsystem defaults for KMM PMask Control hardware
CONFIG_I2C=y
CONFIG_SPI=y
CONFIG_ADC=y

# Disable UART, Enable Segger RTT for Debug
CONFIG_SERIAL=n
CONFIG_USE_SEGGER_RTT=y
CONFIG_RTT_CONSOLE=y
CONFIG_CONSOLE=y

# No 32.768 kHz crystal on this board revision — RC oscillator with
# periodic calibration (declare 500 ppm to the BLE controller)
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_500PPM=y
